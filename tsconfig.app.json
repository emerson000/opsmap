{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": { "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "bundler", "allowJs": true, "checkJs": true, "isolatedModules": true, "verbatimModuleSyntax": true, "resolveJsonModule": true, "strict": true, "skipLibCheck": true, "noEmit": true, "types": ["svelte", "vite/client"] },
  "include": ["src/**/*.ts", "src/**/*.svelte", "src/**/*.js"]
}
