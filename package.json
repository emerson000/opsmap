{
  "name": "opsmap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:server",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "dev:server": "tsx watch server/index.ts",
    "build:server": "tsc -p server/tsconfig.json && esbuild server/index.ts server/cli.ts --bundle --platform=node --format=esm --packages=external --outdir=dist/server",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.13.17",
    "milsymbol": "3.0.5",
    "openid-client": "^6.8.9",
    "svelte": "^5.0.0",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tsconfig/svelte": "^5.0.0",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "svelte-check": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vite": "^6.4.0",
    "vitest": "^5.1.0"
  }
}
